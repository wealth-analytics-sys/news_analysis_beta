# =============================================================================
#  News Interpretation Portal — copy to .env for local runs. NEVER commit .env.
#  In CI the same names are GitHub Actions secrets / repo variables.
#  Read by src/config.py (real environment variables always win over the file).
# =============================================================================

# ---- database ----------------------------------------------------------------
# Supabase SESSION-MODE pooler (IPv4: aws-0-<region>.pooler.supabase.com:5432,
# user postgres.<project-ref>) — NOT the direct db.<ref>.supabase.co host, which is
# IPv6-only and unreachable from GitHub Actions.
DATABASE_URL=

# ---- LLM (Anthropic only) ----------------------------------------------------
# Providers: anthropic | mock   (mock = offline, no keys, no cost — for tests)
# cheap tier  = S2 triage, S3 clustering, S4 extraction   (run_ingest.py)
# strong tier = S6 interpretation in API mode               (run_s6.py api)
# S6 agent mode (Claude Code writes the cards, /s6-interpret) needs no API key.
LLM_PROVIDER=anthropic
LLM_PROVIDER_CHEAP=anthropic
LLM_PROVIDER_STRONG=anthropic
ANTHROPIC_API_KEY=
MODEL_CHEAP_ANTHROPIC=claude-haiku-4-5-20251001
MODEL_STRONG_ANTHROPIC=claude-sonnet-5

# ---- run behaviour -----------------------------------------------------------
# DRY_RUN=true           -> no DB writes and no API spend
# EXTRACT_FULLTEXT=false -> skip article downloads; run on headline + RSS summary
#                           (useful on a network that blocks article fetches)
# NETWORK_TIMEOUT_S      -> hard timeout for any network fetch, so nothing can hang
# INGEST_WORKERS         -> S1 concurrent fetch pool size
DRY_RUN=false
EXTRACT_FULLTEXT=true
NETWORK_TIMEOUT_S=20
# INGEST_WORKERS=8

# ---- corporate proxy / antivirus TLS interception ---------------------------
# On "CERTIFICATE_VERIFY_FAILED": pip install truststore (makes Python trust the OS
# certificate store), or point CA_BUNDLE at a .pem with your corporate root.
# CA_BUNDLE=

# ---- S6 HTTPS gateway (Claude cloud routine; BUILD_NOTES D17) ----
# S6_BACKEND=gateway makes run_s6.py use HTTPS instead of DATABASE_URL.
S6_BACKEND=db
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Written by tools/apply_s6_gateway.py — never commit the real value.
S6_GATEWAY_TOKEN=
